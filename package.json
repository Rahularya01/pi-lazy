{
  "name": "@rahularya01/pi-lazy",
  "version": "0.3.1",
  "description": "LazyVim-style extension manager for Pi Coding Agent — load packages after start or on demand (cmd/tools/keywords).",
  "author": "Rahul Arya",
  "license": "MIT",
  "type": "module",
  "keywords": [
    "pi-package",
    "pi-extension",
    "pi-coding-agent",
    "lazy",
    "lazyvim",
    "extensions",
    "performance",
    "startup"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Rahularya01/pi-lazy.git"
  },
  "homepage": "https://github.com/Rahularya01/pi-lazy#readme",
  "bugs": {
    "url": "https://github.com/Rahularya01/pi-lazy/issues"
  },
  "files": [
    "LICENSE",
    "README.md",
    "CHANGELOG.md",
    "dist",
    "examples"
  ],
  "exports": {
    ".": "./dist/index.js",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "esbuild src/index.ts --bundle --platform=node --format=esm --target=node20 --outfile=dist/index.js --external:@earendil-works/pi-coding-agent --external:typebox",
    "check": "npm run typecheck && npm run build",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.test.json",
    "test:integration": "node scripts/integration-load.mjs",
    "test:smoke": "node scripts/smoke-pi.mjs",
    "test": "npm run check && npm run test:integration",
    "prepublishOnly": "npm run check && npm pack --dry-run"
  },
  "pi": {
    "extensions": [
      "./dist/index.js"
    ]
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "typebox": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "^0.84.2",
    "@types/node": "^24.0.0",
    "esbuild": "^0.25.12",
    "typebox": "^1.0.17",
    "typescript": "^5.9.0"
  },
  "engines": {
    "node": ">=20"
  }
}
